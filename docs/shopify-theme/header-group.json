{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "mm-styles": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Open+Sans:ital,wdth,wght@0,75..100,300..700;1,75..100,300..700&display=swap\">{{ 'mezcalomano.css' | asset_url | stylesheet_tag }}",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "announcement": {
          "type": "announcement",
          "settings": {
            "text": "Pre-orders ship from November 30. Order by December 14 for US Christmas delivery.",
            "link": "shopify://products/discovery-deck"
          }
        }
      },
      "block_order": [
        "announcement"
      ],
      "settings": {
        "auto_rotate": false,
        "change_slides_speed": 5,
        "color_scheme": "scheme-1",
        "show_line_separator": false,
        "show_social": false,
        "enable_country_selector": false,
        "enable_language_selector": false
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "logo_position": "top-center",
        "mobile_logo_position": "center",
        "menu": "main-menu",
        "menu_type_desktop": "drawer",
        "sticky_header_type": "always",
        "show_line_separator": true,
        "color_scheme": "scheme-1",
        "menu_color_scheme": "scheme-1",
        "enable_country_selector": false,
        "enable_language_selector": false,
        "enable_customer_avatar": false,
        "margin_bottom": 0,
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "mm-styles",
    "announcement-bar",
    "header"
  ]
}