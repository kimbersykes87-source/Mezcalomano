# Copy to `.env.local` (or use `.env` — both are gitignored). Next.js loads `.env.local` automatically.
# The seed script and `npm run supabase:push` load `.env` first, then `.env.local` (local wins).
#
# Deployment: the live site builds on Vercel when you push to `main` (GitHub connected in Vercel).
# Copy the same values into Vercel → Project → Settings → Environment Variables.
# After changing NEXT_PUBLIC_* or contact secrets on Vercel, Redeploy so Production picks them up.
#
# Never commit real values. See docs/AGENT_HANDOFF.md and CONNECTIONS.md.

# --- Supabase (directory + map + contact API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: contact form inserts + seed/upload scripts (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional alias for the contact API (falls back to NEXT_PUBLIC_SUPABASE_URL if unset)
# SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase CLI (`npm run supabase:push`) — personal access token, not the anon key
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# Optional: database password (Project Settings → Database) if `supabase link` needs it
# SUPABASE_DB_PASSWORD=

# Optional: explicit ref if URL is nonstandard
# SUPABASE_PROJECT_REF=your-project-ref

# --- Contact form (Turnstile + Apps Script mailer) ---
# Matching pair from the same Cloudflare Turnstile widget (hostname must include mezcalomano.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Deployed Google Apps Script web app (/exec URL) and shared secret (must equal Apps Script SHARED_SECRET)
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
