# Copy to `.env.local` (or use `.env` — both are gitignored). Next.js loads `.env.local` automatically.
# The seed script and `npm run supabase:push` load `.env` first, then `.env.local` (local wins).
#
# Deployment: the live site builds on Vercel when you push to `main` (GitHub connected in Vercel).
# Copy the same values into Vercel → Project → Settings → Environment Variables.
# After changing NEXT_PUBLIC_* or contact secrets on Vercel, Redeploy so Production picks them up.
#
# Never commit real values. See docs/AGENT_HANDOFF.md and CONNECTIONS.md.

# --- Supabase (directory + map + contact API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: contact form inserts + seed/upload scripts (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional alias for the contact API (falls back to NEXT_PUBLIC_SUPABASE_URL if unset)
# SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase CLI (`npm run supabase:push`) — personal access token, not the anon key
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# Optional: database password (Project Settings → Database) if `supabase link` needs it
# SUPABASE_DB_PASSWORD=

# Optional: explicit ref if URL is nonstandard
# SUPABASE_PROJECT_REF=your-project-ref

# --- Contact form (Turnstile + Apps Script mailer) ---
# Matching pair from the same Cloudflare Turnstile widget (hostname must include mezcalomano.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Deployed Google Apps Script web app (/exec URL) and shared secret (must equal Apps Script SHARED_SECRET)
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# --- Mailing list signup (About page form -> /api/subscribe) ---
# Uses the same Turnstile pair as the contact form. Shopify is the list that gets emailed.
# Store domain, e.g. your-store.myshopify.com (the myshopify.com one, not shop.mezcalomano.com)
SHOPIFY_STORE_DOMAIN=
# Client ID and secret of the Shopify Dev Dashboard app (scopes: read_customers, write_customers).
# The app swaps them for a 24 hour Admin API token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for an old-style custom app made before 2026 with a fixed token (overrides the two above)
# SHOPIFY_ADMIN_TOKEN=
# Optional: pin the Admin API version (defaults in src/lib/shopify-subscribe.ts)
# SHOPIFY_API_VERSION=

# Backup copy of every signup in the shared Google Sheet "Mailing_List_Backup".
# Deployed Apps Script web app (/exec URL) and shared secret (must equal the script's SHARED_SECRET).
# Optional: signups still work without these, they just skip the backup row.
MAILING_LIST_SHEET_URL=
MAILING_LIST_SHEET_TOKEN=

# Analytics (admin dashboard, phase 1). Cloudflare Web Analytics site token for
# mezcalomano.com. Public by design (shown in page source). Leave empty locally
# so dev visits are not counted. Click events reuse SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Analytics phase 2: nightly job /api/cron/daily (Vercel Cron sends CRON_SECRET as a Bearer token).
# CRON_SECRET: any long random string, Sensitive in Vercel. CLOUDFLARE_ANALYTICS_TOKEN: Cloudflare API
# token with Account > Account Analytics > Read. Both server-only, never NEXT_PUBLIC_.
CRON_SECRET=
CLOUDFLARE_ANALYTICS_TOKEN=

# Analytics phase 3: Instagram (Meta app with "Instagram API with Instagram Login").
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Analytics phases 4 to 6: admin site, weekly email, TikTok.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
WEEKLY_EMAIL_URL=
WEEKLY_EMAIL_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
